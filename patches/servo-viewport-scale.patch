+    /// Update physical size and HiDPI together, avoiding an intermediate CSS viewport.
+    /// Other WebViews sharing this rendering context are also resized.
+    pub fn resize_with_hidpi_scale_factor(
+        &self,
+        new_size: PhysicalSize<u32>,
+        new_scale: Scale<f32, DeviceIndependentPixel, DevicePixel>,
+    ) {
+        let new_size = PhysicalSize {
+            width: new_size.width.max(MINIMUM_WEBVIEW_SIZE.width as u32),
+            height: new_size.height.max(MINIMUM_WEBVIEW_SIZE.height as u32),
+        };
+        self.inner_mut().hidpi_scale_factor = new_scale;
+        self.servo().paint().resize_rendering_context_with_hidpi(
+            self.id(), new_size, new_scale,
+        );
     }
 
