+    /// Publish one window size message containing the final physical size and scale.
+    pub(crate) fn set_rect_and_hidpi_scale_factor(
+        &mut self,
+        new_rect: DeviceRect,
+        new_scale: Scale<f32, DeviceIndependentPixel, DevicePixel>,
+    ) -> bool {
