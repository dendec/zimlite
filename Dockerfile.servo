# Feasibility builder. Desktop probe only: its glibc is NOT the PortMaster ABI.
FROM rust:1.97.1-bookworm AS toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-16 libclang-16-dev llvm-16-dev cmake ninja-build pkg-config python3 m4 gperf \
    libdbus-1-dev libudev-dev libfontconfig1-dev libfreetype-dev libharfbuzz-dev \
    libx11-dev libxrandr-dev libxcursor-dev libxi-dev libxmu-dev libxext-dev \
    libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev \
    libegl1-mesa-dev libgles2-mesa-dev libgl1-mesa-dev libunwind-dev \
    liblzma-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
ENV LIBCLANG_PATH=/usr/lib/llvm-16/lib

FROM toolchain AS builder
WORKDIR /build
COPY lib/servo lib/servo
COPY patches/servo-unifont-fallback.patch patches/servo-viewport-scale.patch patches/
RUN git apply --directory=lib/servo patches/servo-unifont-fallback.patch patches/servo-viewport-scale.patch
COPY native/servo-host native/servo-host
WORKDIR /build/native/servo-host
ENV CARGO_TARGET_DIR=/build/target
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --locked --release && \
    mkdir -p /dist && cp /build/target/release/zimlite-servo-host /dist/

# Hardware feasibility build for recent firmware (glibc >= 2.36).
# This does not yet provide the glibc 2.30 ABI required by the complete matrix.
FROM toolchain AS arm64-builder
RUN dpkg --add-architecture arm64 && apt-get update && \
    apt-get install -y --no-install-recommends \
    g++-aarch64-linux-gnu binutils-aarch64-linux-gnu \
    libfontconfig1-dev:arm64 libfreetype-dev:arm64 libharfbuzz-dev:arm64 \
    libdbus-1-dev:arm64 libudev-dev:arm64 libunwind-dev:arm64 \
    libx11-dev:arm64 libxrandr-dev:arm64 libxcursor-dev:arm64 libxi-dev:arm64 \
    libxmu-dev:arm64 libxext-dev:arm64 libegl1-mesa-dev:arm64 \
    libgles2-mesa-dev:arm64 libgl1-mesa-dev:arm64 liblzma-dev:arm64 zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add aarch64-unknown-linux-gnu
ENV PATH=/usr/lib/llvm-16/bin:$PATH
ENV CARGO_TARGET_DIR=/build/target \
    CARGO_BUILD_TARGET=aarch64-unknown-linux-gnu \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-g++ \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
WORKDIR /build
COPY lib/servo lib/servo
COPY patches/servo-unifont-fallback.patch patches/servo-viewport-scale.patch patches/
RUN git apply --directory=lib/servo patches/servo-unifont-fallback.patch patches/servo-viewport-scale.patch
COPY native/servo-host native/servo-host
WORKDIR /build/native/servo-host
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=zimlite-servo-arm64,target=/build/target \
    cargo build --locked --release && \
    mkdir -p /dist && cp /build/target/aarch64-unknown-linux-gnu/release/zimlite-servo-host /dist/ && \
    aarch64-linux-gnu-readelf -d /dist/zimlite-servo-host > /dist/dynamic.txt

FROM scratch AS arm64-probe
COPY --from=arm64-builder /dist/ /

FROM scratch AS desktop-helper
COPY --from=builder /dist/ /

FROM debian:bookworm-slim AS probe
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb libgl1-mesa-dri libegl1 libgl1 libfontconfig1 libdbus-1-3 \
    libx11-6 libxrandr2 libxcursor1 libxi6 libxext6 libunwind8 libudev1 \
    fontconfig fonts-dejavu-core fonts-freefont-otf ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /dist/zimlite-servo-host /usr/local/bin/
COPY internal/renderer/assets/unifont.otf /usr/local/share/fonts/zimlite/unifont.otf
